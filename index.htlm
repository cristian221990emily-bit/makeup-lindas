<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Makeup Lind@s</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#050505;color:#fff;font-family:Arial,sans-serif}.bar{background:#D4AF37;color:#000;text-align:center;padding:9px;font-size:10px;font-weight:900}.top{background:#000;padding:18px;text-align:center;border-bottom:2px solid #D4AF37;position:sticky;top:0;z-index:10}.top h1{color:#D4AF37;font-size:24px;letter-spacing:2px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px;max-width:900px;margin:auto}.card{background:#121212;border:1px solid #222;border-radius:22px;overflow:hidden}.card img{width:100%;height:270px;object-fit:cover}.info{padding:12px;text-align:center}.info h3{color:#fff;font-size:11px;font-weight:900;min-height:32px;display:flex;align-items:center;justify-content:center}.info small{color:#D4AF37;font-size:9px;display:block;margin:6px 0 10px}.btn{display:block;background:#D4AF37;color:#000;padding:11px;border-radius:25px;font-weight:900;font-size:11px;text-decoration:none}.wsp{position:fixed;bottom:20px;right:16px;background:#25D366;width:62px;height:62px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff;text-decoration:none;box-shadow:0 0 20px rgba(37,211,102,.6);z-index:99;animation:bote 1.4s infinite}@keyframes bote{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}</style></head><body><div class="bar">🚚 DOMICILIO GRATIS EN CALI POR COMPRAS MAYORES A $80.000</div><div class="top"><h1>MAKEUP LIND@S</h1></div><div class="grid" id="g"></div><a class="wsp" href="https://wa.me/573161465193?text=Hola%20Makeup%20Lindas%20quiero%20info">💬</a><script>
const N={
"WA0738":"WATERMELON","WA1641":"PIÑA COLADA","WA2306":"PIÑA COLADA",
"WA4926":"BUBBLE GUM","WA4936":"BUBBLE GUM",
"WA5103":"ALGODÓN DE AZÚCAR","WA5361":"VAINILLA COCO",
"WA5285":"BUBBLE GUM ROSA","WA7895":"BIRTHDAY CAKE","WA9191":"BRILLI BRILLI - SPRAY DORADO"
};
fetch('https://api.github.com/repos/cristian221990emily-bit/makeup-lindas/contents').then(r=>r.json()).then(f=>{
 let imgs=f.filter(x=>x.name.match(/\.jpg|\.png|\.jpeg/i));
 let g=document.getElementById('g'); g.innerHTML='';
 imgs.forEach(x=>{
  let k=Object.keys(N).find(c=>x.name.toUpperCase().includes(c));
  let nombre = k ? N[k] : "PURPURE ORIGINAL";
  // NUNCA mostrar IMG-....
  g.innerHTML+=`<div class=card><img src="${x.name}"><div class=info><h3>MANTEQUILLA PURPURE<br>${nombre}</h3><small>Purpure Original • 250g</small><a class=btn href="https://wa.me/573161465193?text=Hola%20quiero%20la%20${nombre}">WHATSAPP</a></div></div>`;
 });
});
</script></body></html>
